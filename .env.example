# ---- AI (server-side only, NEVER expose with VITE_ prefix) ----
GEMINI_API_KEY=
# Model lite + tắt thinking: trả JSON trong ~2-4s. Model 3.8 flash mất ~25s.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_BUDGET=0
# Server AI tự host ở domain khác web: cho phép domain web gọi sang (vd https://tkb.vercel.app)
AI_ALLOWED_ORIGIN=
# Web gọi server AI ở domain khác thì điền URL gốc server (để trống = cùng domain /api)
VITE_AI_URL=

# ---- Supabase (optional: bỏ trống thì app chạy localStorage) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
